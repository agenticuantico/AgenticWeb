{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "agenticweb",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/v1/*",
      "/health"
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "HF_MODEL": "Qwen/Qwen3.8-27B",
    "HF_API_URL": "https://router.huggingface.co/v1/chat/completions",
    "HF_MODELS": "Qwen/Qwen3.8-27B,Qwen/Qwen3.8-27B-FP8,Qwen/Qwen3.6-27B"
  }
}
