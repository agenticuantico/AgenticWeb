{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "agenticweb",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/v1/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "HF_MODEL": "Qwen/Qwen3.8-27B",
    "HF_API_URL": "https://router.huggingface.co/v1/chat/completions",
    "CORE_API_ORIGIN": "https://agenti-cuanticocore-live-production.up.railway.app"
  }
}
