{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "agenticweb",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/v1/*",
      "/health"
    ]
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DATA",
        "class_name": "UserData"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-user-data-sqlite",
      "new_sqlite_classes": ["UserData"]
    }
  ],
  "exports": {
    "UserData": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "HF_MODEL": "Qwen/Qwen3.8-27B",
    "HF_API_URL": "https://router.huggingface.co/v1/chat/completions",
    "HF_MODELS": "Qwen/Qwen3-VL-30B-A3B-Instruct,Qwen/Qwen3.8-27B,Qwen/Qwen3.8-27B-FP8,Qwen/Qwen3.6-27B",
    "HF_ASTRA_MODEL": "P0x0/Astra-v1-12B-GGUF",
    "HF_WEB_DESIGN_MODEL": "Qwen/Qwen3-Coder-30B-A3B-Instruct:fastest",
    "HF_DESIGNER_MODEL": "Qwen/Qwen3-Coder-Next:novita",
    "CF_AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "ai": {
    "binding": "AI"
  }
}
