{
  "id": "/",
  "name": "AgentiCuántico",
  "short_name": "AgentiCuántico",
  "description": "Agentes de IA autónomos con cerebro cuántico agentic. Voz, avatar 3D y privacidad desde el diseño.",
  "lang": "es-AR",
  "dir": "ltr",
  "start_url": "/app/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#05070c",
  "theme_color": "#05070c",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/assets/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/img/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/img/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Nuevo chat", "short_name": "Chat", "url": "/app/#/new", "icons": [{ "src": "/assets/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Planes", "short_name": "Planes", "url": "/app/#/plans", "icons": [{ "src": "/assets/img/icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "/assets/img/screenshot-mobile.png", "sizes": "750x1624", "type": "image/png", "form_factor": "narrow", "label": "AgentiCuántico en el celular" },
    { "src": "/assets/img/screenshot-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "AgentiCuántico en escritorio" }
  ]
}
